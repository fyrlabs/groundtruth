{
  "name": "@fyrlabs/groundtruth",
  "version": "0.2.0",
  "description": "Code-grounded research profiles for GitHub repos. Clones each repo and adjudicates its claims against the implementation.",
  "keywords": [
    "claude-code",
    "claude",
    "ai",
    "research",
    "verification",
    "provenance",
    "agents",
    "mcp"
  ],
  "author": {
    "name": "fyrlabs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fyrlabs/groundtruth.git"
  },
  "homepage": "https://github.com/fyrlabs/groundtruth#readme",
  "bugs": {
    "url": "https://github.com/fyrlabs/groundtruth/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "files": [
    ".claude-plugin/",
    "agents/",
    "skills/",
    "hooks/",
    "scripts/",
    "core/",
    "config/",
    "test/",
    "docs/",
    "AGENTS.md",
    "CLAUDE.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "SKILL.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "verify": "node scripts/verify-layout.mjs && node scripts/lint-frontmatter.mjs && node scripts/run-tests.mjs",
    "verify:layout": "node scripts/verify-layout.mjs",
    "verify:frontmatter": "node scripts/lint-frontmatter.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:injection": "node scripts/run-tests.mjs injection",
    "test:state": "node scripts/run-tests.mjs state",
    "test:render": "node scripts/run-tests.mjs render",
    "pack:check": "node scripts/check-pack.mjs",
    "plugin:validate": "claude plugin validate ."
  }
}